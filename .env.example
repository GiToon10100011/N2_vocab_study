# Neon 대시보드 > Connection Details 에서 "Pooled connection" 문자열을 복사한다.
# (호스트 이름에 -pooler 가 들어간 쪽이다)
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# 앱 접속 비밀번호. 회원가입/로그인 기능이 아니라 공개 URL 을 막는 최소 잠금이다.
APP_PASSWORD="아무거나-길게"

# 세션 쿠키 서명 키. 아래 명령으로 생성한다:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=""

# 하루 경계 계산에 쓰는 시간대 (기본값 Asia/Seoul)
APP_TIMEZONE="Asia/Seoul"
