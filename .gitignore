# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# 예시 파일은 커밋한다 (실제 값은 .env.local 에만 있다)
!.env.example

# playwright
test-results/
playwright-report/

# 오답 기록은 의도적으로 백업하지 않는다. 저장소가 공개이고 교재 문항 내용과 개인 메모가
# 들어가기 때문이다. 옛 스크립트가 파일을 만들어도 커밋되지 않게 막아 둔다.
backups/mistakes.csv
